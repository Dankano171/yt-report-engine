{
  "provider": "gemini",
  "model": "gemini-flash-lite-latest",
  "fallbackModel": "gemini-2.5-flash",
  "classificationModel": "gemini-flash-lite-latest",
  "classificationFallbackModel": "gemini-2.5-flash",
  "writingModel": "gemini-flash-lite-latest",
  "writingFallbackModel": "gemini-2.5-flash",
  "emailFrom": "Creator Reports <reports@your-verified-domain.example>",
  "limits": {
    "maxVideos": 8,
    "maxThreadsPerVideo": 300,
    "maxUsdPerRun": 0.5,
    "maxUsdPerDay": 2,
    "maxOutputTokensPerComment": 60,
    "outputTokenOverhead": 256
  },
  "channels": [
    {
      "handle": "@examplecreator",
      "creatorName": "Example Creator",
      "creatorGoal": "grow_audience",
      "recipients": ["you@example.com"],
      "productKeywords": ["Example product"]
    }
  ]
}
